generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Room {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  messages  Message[]
  timer     TimerState?
}

model Message {
  id         String   @id @default(cuid())
  roomId     String
  senderName String
  content    String
  createdAt  DateTime @default(now())
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt, id])
}

model TimerState {
  roomId           String   @id
  mode             String
  status           String
  durationSeconds  Int
  remainingSeconds Float
  startedAt        DateTime?
  revision         Int
  updatedAt        DateTime @updatedAt
  room             Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}
