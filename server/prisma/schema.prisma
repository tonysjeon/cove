generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Room {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  expiresAt DateTime? @default(dbgenerated("((CURRENT_TIMESTAMP AT TIME ZONE 'UTC') + '24 hours'::interval)"))
  reservedCode RoomCode @relation(fields: [code], references: [code])
  messages  Message[]
  timer     TimerState?

  @@index([expiresAt])
}

// Keep only the code after deletion so old invites cannot be reused.
model RoomCode {
  code String @id
  room Room?
}

model Message {
  id         String   @id @default(cuid())
  roomId     String
  senderName String
  content    String
  createdAt  DateTime @default(now())
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt, id])
}

model TimerState {
  roomId           String   @id
  mode             String
  status           String
  durationSeconds  Int
  remainingSeconds Float
  startedAt        DateTime?
  revision         Int
  updatedAt        DateTime @updatedAt
  room             Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}
